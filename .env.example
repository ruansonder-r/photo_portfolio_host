# Copy to .env for local development. Never commit .env.

# --- Django ---
DEBUG=True
# Required when DEBUG=False. Generate: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,ruansonder-r.com,www.ruansonder-r.com

# --- Database ---
# Omit entirely to use local SQLite. In production set the Postgres URL.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Cloudinary (image hosting) ---
# Dashboard -> "API Environment variable". This one line is all the SDK needs.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_PUBLIC_FOLDER=portfolio
CLOUDINARY_PRIVATE_FOLDER=albums
# Optional: only on plans with token-based auth. Adds a real expiry to private
# album URLs on top of the signature.
# CLOUDINARY_AUTH_TOKEN_KEY=

# --- Site identity ---
PHOTOGRAPHER_NAME=Ruansonder_R
PHOTOGRAPHER_HANDLE=ruansonder_R
PHOTOGRAPHER_WHATSAPP=+27 82 813 9850
PHOTOGRAPHER_EMAIL=ruansonder.r@gmail.com
PHOTOGRAPHER_LOCATION=Cape Town, South Africa
INSTAGRAM_URL=https://instagram.com/ruansonder_R

# --- Google Drive: needed ONLY to run `migrate_from_drive` once ---
# GOOGLE_DRIVE_CREDENTIALS={"type":"service_account",...}
# GOOGLE_DRIVE_CREDENTIALS_FILE=/path/to/service-account.json
